  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:prod": "rsbuild build --mode=production",
    "build": "rsbuild build --mode=development",
    "format": "npx oxfmt --check",
    "format:fix": "npx oxfmt",
    "lint": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "start": "rsbuild start --mode=development",
    "start:prod": "rsbuild start --mode=production",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "checks": "npm run lint && npm run type-check && npm run test && npm run format"
  },
  "dependencies": {
    "@progress/kendo-file-saver": "^1.1.2",
    "@progress/kendo-react-grid": "^14.2.1",
    "@progress/kendo-theme-default": "^13.0.1",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.1",
    "@rsbuild/plugin-react": "^1.4.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^7.1.4",
    "globals": "^17.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
