{
  "name": "drautage.laundry.db",
  "version": "1.0.0",
  "description": "A database of laundry products",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:prod": "rsbuild build --mode=production",
    "build": "rsbuild build --mode=development",
    "format": "npx oxfmt --check",
    "format:fix": "npx oxfmt",
    "lint": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "start": "rsbuild dev",
    "start:prod": "rsbuild build --mode=production && rsbuild preview",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "checks": "npm run lint && npm run format && npm run type-check && npm run test"
  },
  "dependencies": {
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.1.8",
    "@rsbuild/plugin-react": "^2.1.0",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^7.1.4",
    "globals": "^17.7.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "style-loader": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=12.0.1"
  },
  "packageManager": "npm@12.0.1",
  "allowScripts": {
    "@swc/core": false,
    "unrs-resolver": false
  }
}
