{
  "name": "drautage.laundry.db",
  "version": "1.0.0",
  "description": "A database of laundry products",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build:prod": "rsbuild build --mode=production",
    "build": "rsbuild build --mode=development",
    "format": "npx oxfmt --check",
    "format:fix": "npx oxfmt",
    "lint": "npx oxlint",
    "lint:fix": "npx oxlint --fix",
    "start": "rsbuild start --mode=development",
    "start:prod": "rsbuild start --mode=production",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "checks": "npm run lint && npm run type-check && npm run test && npm run format"
  },
  "dependencies": {
    "ag-grid-community": "^35.2.1",
    "ag-grid-react": "^35.2.1",
    "i18n-iso-countries": "^7.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "css-loader": "^7.1.4",
    "globals": "^17.4.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "ts-jest": {
      "typescript": "^6.0.2"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
