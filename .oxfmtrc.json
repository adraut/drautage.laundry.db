{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 120,
  "semi": true,
  "experimentalSortPackageJson": true,
  "ignorePatterns": ["/node_modules", "/dist", "/build", "/coverage", "/CHANGELOG.md"],
  "useTabs": false,
  "tabWidth": 2
}
