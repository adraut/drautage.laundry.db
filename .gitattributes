# Normalize all text files to LF on all platforms, overriding core.autocrlf
* text=auto eol=lf

# Binary files — never diff or convert
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.zip binary
*.tar binary
*.gz binary
